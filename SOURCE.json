{
  "repository": "coleam00/Archon",
  "commit": "72817c50dc51bb91773f71e5448bb7d387bfc8dd",
  "scope": "archon-deliver-block plus a minimal DAGU attention wrapper",
  "rounds": 4,
  "inputs": [
    "pull_request",
    "branch",
    "work",
    "part",
    "errors"
  ],
  "mapping": [
    {
      "archon_node": "implement",
      "kind": "include",
      "target": "archon-implement",
      "depends_on": [],
      "when": null,
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "pr",
      "kind": "include",
      "target": "archon-pr",
      "depends_on": [
        "implement"
      ],
      "when": "$implement.output.green == true || $implement.output.red_cause == 'inherited' || $implement.output.red_cause == 'environment'",
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "review",
      "kind": "include",
      "target": "archon-review-block",
      "depends_on": [
        "pr"
      ],
      "when": null,
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "simplify",
      "kind": "include",
      "target": "archon-simplify",
      "depends_on": [
        "review"
      ],
      "when": "$review.output.ready == true",
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "reshape",
      "kind": "include",
      "target": "archon-implement",
      "depends_on": [
        "simplify"
      ],
      "when": "$simplify.output.findings == true",
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "rereview",
      "kind": "include",
      "target": "archon-review-block",
      "depends_on": [
        "reshape"
      ],
      "when": null,
      "trigger_rule": "all_success"
    },
    {
      "archon_node": "settle-threads",
      "kind": "command",
      "target": "settle-threads",
      "depends_on": [
        "pr",
        "review",
        "rereview"
      ],
      "when": "$LOOP_PREV.threads.output.open > 0",
      "trigger_rule": "none_failed_min_one_success"
    },
    {
      "archon_node": "ci",
      "kind": "command",
      "target": "ci",
      "depends_on": [
        "review",
        "simplify",
        "rereview",
        "settle-threads"
      ],
      "when": "$review.output.ready == true && $simplify.output.findings == false || $review.output.ready == true && $simplify.output.findings == true && $rereview.output.ready == true",
      "trigger_rule": "none_failed_min_one_success"
    },
    {
      "archon_node": "threads",
      "kind": "script",
      "target": "threads",
      "depends_on": [
        "pr",
        "review",
        "rereview",
        "ci",
        "settle-threads"
      ],
      "when": null,
      "trigger_rule": "none_failed_min_one_success"
    },
    {
      "archon_node": "round",
      "kind": "script",
      "target": "round",
      "depends_on": [
        "implement",
        "pr",
        "review",
        "rereview",
        "ci",
        "threads"
      ],
      "when": null,
      "trigger_rule": "all_done"
    }
  ],
